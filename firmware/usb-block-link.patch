+/**
+ * USB block link: the SCSI side of the board asks the Mac (over the second USB CDC port)
+ * for disk blocks instead of reading them from the SD card.
+ *
+ * Frames (little endian):
+ *   board -> Mac  request  : B5 C5 cmd tag lba[4] count[2] pad[2]  (12 bytes, WRITE is followed by count*512 bytes)
+ *   Mac   -> board response: C5 B5 status tag count[2]             (6 bytes, READ is followed by count*512 bytes)
+ *   cmd: 1 = READ, 2 = WRITE, 4 = PING, 5 = CONFIG, 6 = CHANGES     status: 0 = ok
+ *   CHANGES (board polls while the SCSI bus is idle): the response count field is a counter the Mac bumps after each
+ *   edit it made to the served image; when it changes the board posts a UNIT ATTENTION (medium may have changed).
+ */
+#pragma once
+#include <stdint.h>
+#include <stdbool.h>
+
+#define USBBLK_CDC_ITF 1
+
+// True while the Mac application has the link port open.
+bool usbblk_connected();
+
+// Blocks are 512 bytes. Return false on timeout / error.
+bool usbblk_read(uint32_t lba, uint32_t count, void *dst);
+bool usbblk_write(uint32_t lba, uint32_t count, const void *src);
+
+// Called from the main loop: runs the loopback self test when the Mac connects.
+void usbblk_poll();
+
+// ---- Card-less mode: no SD card, the Mac tells the board which drive to present (cmd 5 = CONFIG) ----
+//   CONFIG response data (512 bytes): "CFG1", id (1 byte), pad (3), size in MB (u32 LE)
+extern bool     g_usbblk_cardless;      // running without an SD card
+extern int      g_usbblk_cfg_id;        // SCSI id requested by the Mac, -1 = not configured yet
+extern uint32_t g_usbblk_cfg_mb;        // disk size in MB requested by the Mac
+extern bool     g_usbblk_media_changed;  // the Mac edited the disk behind the sampler's back: post a UNIT ATTENTION
+extern bool     g_usbblk_reinit_needed; // set when the Mac gave a new configuration: main loop re-runs reinitSCSI()
