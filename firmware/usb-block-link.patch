+// USB block drive: a virtual disk whose blocks are served by the Mac over the USB block link.
+// ini:  [SCSI]  USBBlockDriveSCSIID=3   USBBlockDriveMB=64
+bool scsiDiskActivateUsbDrive()
+{
+    long id = -1, mb = 64;
+    if (g_usbblk_cardless)
+    {
+        id = g_usbblk_cfg_id; mb = (long)g_usbblk_cfg_mb;   // configured by the Mac over the USB link
+        if (id < 0 || mb <= 0) return false;
+    }
+    else
+    {
+        id = ini_getl("SCSI", "USBBlockDriveSCSIID", -1, CONFIGFILE);
+        if (id < 0 || id > 7) return false;
+        mb = ini_getl("SCSI", "USBBlockDriveMB", 64, CONFIGFILE);
+    }
+    if (s2s_getConfigById(id))
+    {
+        logmsg("---- USB block drive: SCSI id ", (int)id, " is already in use, not enabling");
+        return false;
+    }
+    char name[24];
+    snprintf(name, sizeof name, "USB:%ld", mb);
+    logmsg("---- Activating USB block drive, SCSI id ", (int)id, " size ", (int)mb, " MB (blocks served by the Mac)");
+    g_scsi_settings.initDevice(id, S2S_CFG_FIXED);
+    bool ok = scsiDiskOpenHDDImage(id, name, 0, 512, S2S_CFG_FIXED);
+    if (!ok) logmsg("---- USB block drive activation failed");
+    return ok;
+}
