+static uint8_t s_tag = 0;
+static bool s_cfgDone = false;
+static uint32_t s_cfgNextTry = 0;
+static bool s_wasConnected = false;
+static uint32_t s_failures = 0;
+
+static void pump()
+{
+    if (mutex_try_enter(&__usb_mutex, NULL))
+    {
+        tud_task();
+        mutex_exit(&__usb_mutex);
+    }
+}
+
+bool usbblk_connected()
+{
+    return tud_cdc_n_connected(USBBLK_CDC_ITF);
+}
+
+static bool sendAll(const uint8_t *p, uint32_t len, uint32_t deadline)
+{
+    while (len > 0)
+    {
+        uint32_t n = tud_cdc_n_write(USBBLK_CDC_ITF, p, len);
+        tud_cdc_n_write_flush(USBBLK_CDC_ITF);
+        p += n; len -= n;
+        pump();
+        if (len > 0 && to_ms_since_boot(get_absolute_time()) > deadline)
+            return false;
+        if (!usbblk_connected()) return false;
+    }
+    return true;
+}
+
+static bool recvAll(uint8_t *p, uint32_t len, uint32_t deadline)
+{
+    while (len > 0)
+    {
+        uint32_t n = tud_cdc_n_read(USBBLK_CDC_ITF, p, len);
+        p += n; len -= n;
+        if (len == 0) break;
+        pump();
+        if (to_ms_since_boot(get_absolute_time()) > deadline) return false;
+        if (!usbblk_connected()) return false;
+    }
+    return true;
+}
+
+static bool transfer(uint8_t cmd, uint32_t lba, uint32_t count, uint8_t *rdst, const uint8_t *wsrc, uint32_t timeoutMs = USBBLK_TIMEOUT_MS)
+{
+    if (!usbblk_connected()) return false;
+    uint8_t tag = ++s_tag;
+    uint8_t req[12] = { 0xB5, 0xC5, cmd, tag,
+                        (uint8_t)lba, (uint8_t)(lba >> 8), (uint8_t)(lba >> 16), (uint8_t)(lba >> 24),
+                        (uint8_t)count, (uint8_t)(count >> 8), 0, 0 };
+    uint32_t deadline = to_ms_since_boot(get_absolute_time()) + timeoutMs;
+
+    // drop stale bytes from an earlier timed-out exchange
+    uint8_t junk[64];
+    while (tud_cdc_n_available(USBBLK_CDC_ITF)) tud_cdc_n_read(USBBLK_CDC_ITF, junk, sizeof junk);
+
+    if (!sendAll(req, sizeof req, deadline)) { s_failures++; return false; }
+    if (cmd == 2 && !sendAll(wsrc, count * 512, deadline)) { s_failures++; return false; }
+
+    uint8_t rsp[6];
+    if (!recvAll(rsp, sizeof rsp, deadline)) { s_failures++; return false; }
+    if (rsp[0] != 0xC5 || rsp[1] != 0xB5 || rsp[3] != tag || rsp[2] != 0) { s_failures++; return false; }
+    s_rspCount = (uint16_t)(rsp[4] | (rsp[5] << 8));
+    if ((cmd == 1 || cmd == 5) && !recvAll(rdst, count * 512, deadline)) { s_failures++; return false; }
+    return true;
+}
+
+bool usbblk_read(uint32_t lba, uint32_t count, void *dst)
+{
+    uint8_t *d = (uint8_t *)dst;
+    while (count > 0)
+    {
+        uint32_t n = count > USBBLK_MAX_BLOCKS ? USBBLK_MAX_BLOCKS : count;
+        if (!transfer(1, lba, n, d, nullptr)) return false;
+        lba += n; count -= n; d += n * 512;
+    }
+    return true;
+}
+
+bool usbblk_write(uint32_t lba, uint32_t count, const void *src)
+{
+    const uint8_t *s = (const uint8_t *)src;
+    while (count > 0)
+    {
+        uint32_t n = count > USBBLK_MAX_BLOCKS ? USBBLK_MAX_BLOCKS : count;
+        if (!transfer(2, lba, n, nullptr, s)) return false;
+        lba += n; count -= n; s += n * 512;
+    }
+    return true;
+}
+
+// Loopback self test: when the Mac opens the link port, read 4 MB in 64 kB requests and log
+// the checksum and speed on the normal serial console. The Mac tool prints the same checksum.
+// While the SCSI bus is idle, ask the Mac whether it edited the disk; if so the sampler gets a UNIT ATTENTION.
+static void mediaChangePoll()
+{
+    uint32_t t = to_ms_since_boot(get_absolute_time());
+    if ((int32_t)(t - s_nextChangePoll) < 0) return;
+    s_nextChangePoll = t + 700;
+    if (!transfer(6, 0, 0, nullptr, nullptr, 100)) return;     // short timeout: never stall the SCSI side
+    if (!s_changeInit) { s_changeInit = true; s_lastChange = s_rspCount; return; }
+    if (s_rspCount != s_lastChange)
+    {
+        s_lastChange = s_rspCount;
+        g_usbblk_media_changed = true;
+        logmsg("USB block link: the Mac edited the disk, posting a unit attention");
+    }
+}
+
+static void cardlessConfigPoll(bool now)
+{
+    if (!now) { s_cfgDone = false; s_changeInit = false; return; }
+    if (s_cfgDone) { if (scsiDev.phase == BUS_FREE) mediaChangePoll(); return; }
+    uint32_t t = to_ms_since_boot(get_absolute_time());
+    if ((int32_t)(t - s_cfgNextTry) < 0) return;
+    s_cfgNextTry = t + 2000;
+    static uint8_t cfg[512];
+    if (!transfer(5, 0, 1, cfg, nullptr)) { logmsg("USB block link: no configuration from the Mac yet"); return; }
+    if (memcmp(cfg, "CFG1", 4) != 0 || cfg[4] > 7) { logmsg("USB block link: bad configuration from the Mac"); return; }
+    uint32_t mb = cfg[8] | (cfg[9] << 8) | (cfg[10] << 16) | ((uint32_t)cfg[11] << 24);
+    if (mb == 0) { logmsg("USB block link: Mac sent an empty configuration"); return; }
+    s_cfgDone = true;
+    if (g_usbblk_cfg_id != cfg[4] || g_usbblk_cfg_mb != mb)
+    {
+        g_usbblk_cfg_id = cfg[4]; g_usbblk_cfg_mb = mb;
+        logmsg("USB block link: Mac configured SCSI id ", (int)cfg[4], ", ", (int)mb, " MB");
+        g_usbblk_reinit_needed = true;
+    }
+}
+
+void usbblk_poll()
+{
+    bool now = usbblk_connected();
+    if (g_usbblk_cardless)
+    {
+        cardlessConfigPoll(now);
+        if (now != s_wasConnected)
+        {
+            s_wasConnected = now;
+            logmsg(now ? "USB block link: Mac connected" : "USB block link: Mac disconnected");
+        }
+        return;   // no loopback self test without a card
+    }
+    if (now && !s_wasConnected)
+    {
+        s_wasConnected = true;
+        logmsg("USB block link: Mac connected, running loopback self test");
+        static uint8_t buf[USBBLK_MAX_BLOCKS * 512];
+        uint32_t t0 = to_ms_since_boot(get_absolute_time());
+        uint32_t sum = 0, bytes = 0, lba = 0;
+        bool ok = true;
+        for (int i = 0; i < 64 && ok; i++)
+        {
+            ok = usbblk_read(lba, USBBLK_MAX_BLOCKS, buf);
+            if (ok)
+            {
+                for (uint32_t j = 0; j < sizeof buf; j++) sum = sum * 31 + buf[j];
+                lba += USBBLK_MAX_BLOCKS; bytes += sizeof buf;
+            }
+        }
+        uint32_t ms = to_ms_since_boot(get_absolute_time()) - t0;
+        if (ok)
+            logmsg("USB block link: read ", (int)(bytes / 1024), " kB in ", (int)ms, " ms, checksum ", (int)sum);
+        else
+            logmsg("USB block link: self test FAILED after ", (int)bytes, " bytes");
+    }
+    else if (!now && s_wasConnected)
+    {
+        s_wasConnected = false;
+        logmsg("USB block link: Mac disconnected");
+    }
+}
